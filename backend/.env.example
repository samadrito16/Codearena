# CodeArena Backend Environment Configuration

# Server
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Security
SESSION_SECRET=codearena_super_secret_session_key_replace_in_production_32chars
SESSION_EXPIRY_DAYS=7

# Email Delivery (Optional in dev: reset links are printed to console)
# Resend API Key:
RESEND_API_KEY=
# Or SMTP:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@codearena.dev

# OnlineCompiler.io Code Execution Engine (Free tier: 100,000 executions/month)
ONLINECOMPILER_API_KEY=
ONLINECOMPILER_API_URL=https://api.onlinecompiler.io/api/run-code-sync/

# AI Coding Assistant (Optional)
GEMINI_API_KEY=
