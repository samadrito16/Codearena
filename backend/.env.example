# PrismCode Backend Environment Configuration

# Server
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Security & Sandboxing
SESSION_SECRET=prismcode_super_secret_session_key_replace_in_production_32chars
SESSION_EXPIRY_DAYS=7
ALLOW_UNSAFE_LOCAL_EXECUTION=false
ENABLE_DEV_TOKENS=false
BEHIND_PROXY=false
# ADMIN_SEED_PASSWORD=your_custom_admin_password

# Clerk Authentication (Optional)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Email Delivery (Optional in dev: reset links are printed to console)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@prismcode.dev

# OnlineCompiler.io Code Execution Engine (Free tier: 100,000 executions/month)
ONLINECOMPILER_API_KEY=
ONLINECOMPILER_API_URL=https://api.onlinecompiler.io/api/run-code-sync/

# AI Coding Assistant (Optional)
GEMINI_API_KEY=
